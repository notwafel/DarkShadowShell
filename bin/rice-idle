#!/usr/bin/env python3
"""rice-idle: idle timers (hypridle). Settings > Desktop > Idle & Login screen.

  rice-idle state | set KEY VALUE | apply | reset | restore | screen on|off
  keys: screen_off_after (minutes, 0 = never), suspend_after (minutes, 0 = never)

The shell has no lock screen of its own (V4.52 removed it, and the old hyprlock one). hypridle only turns the
screen off and puts the computer to sleep. Your own lock screen, if you have one, is yours to bind."""
import fcntl
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/idle.json"
OLD = DIR + "/lock.json"          # before V4.52 (the two timers are taken from it once)
IDLE = HOME + "/.config/hypr/hypridle.conf"
BIN = HOME + "/.local/bin"
DEFAULTS = {"screen_off_after": 0, "suspend_after": 15}
RANGES = {"screen_off_after": (0, 120), "suspend_after": (0, 240)}


def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def load():
    c = dict(DEFAULTS)
    raw = {}
    for p in (CFG, OLD):
        try:
            raw = json.load(open(p))
            break
        except Exception:
            continue
    for k, (lo, hi) in RANGES.items():
        try:
            c[k] = int(max(lo, min(hi, float(raw.get(k, DEFAULTS[k])))))
        except Exception:
            c[k] = DEFAULTS[k]
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, CFG)


def idle_text(c):
    sc = BIN + "/rice-idle screen"
    out = ["# Generated by rice-idle (Settings > Idle & Login screen). 0 minutes = never.",
           "general {\n    after_sleep_cmd = %s on\n}" % sc]
    if c["screen_off_after"] > 0:
        out.append("# screen off\nlistener {\n    timeout = %d\n    on-timeout = %s off\n    on-resume = %s on\n}"
                   % (c["screen_off_after"] * 60, sc, sc))
    if c["suspend_after"] > 0:
        out.append("# sleep\nlistener {\n    timeout = %d\n    on-timeout = $HOME/.local/bin/rice-sys suspend\n}" % (c["suspend_after"] * 60))
    return "\n\n".join(out) + "\n"


def restart_idle():
    """hypridle reads its config only at start: restart it once, and keep only one copy running."""
    if not shutil.which("hypridle"):
        return
    q = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    t = dict(q, timeout=10)
    try:
        active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "hypridle.service"], **t).returncode == 0
    except Exception:
        active = False
    if active:
        try:
            subprocess.run(["systemctl", "--user", "restart", "hypridle.service"], **t)
            main = subprocess.run(["systemctl", "--user", "show", "-p", "MainPID", "--value", "hypridle.service"],
                                  capture_output=True, text=True, timeout=10).stdout.strip()
            pids = subprocess.run(["pgrep", "-x", "hypridle"], capture_output=True, text=True).stdout.split()
        except Exception:
            main, pids = "", []
        for pid in pids:
            if pid != main:
                subprocess.run(["kill", pid], **q)
    else:
        try:
            subprocess.run(["pkill", "-x", "hypridle"], **q)
        except Exception:
            pass
        try:
            subprocess.Popen(["hypridle"], start_new_session=True, **q)
        except Exception:
            pass


def apply(c):
    text = idle_text(c)
    try:
        old = open(IDLE).read()
    except Exception:
        old = None
    if old == text:
        return
    os.makedirs(os.path.dirname(IDLE), exist_ok=True)
    if old is not None and not os.path.exists(IDLE + ".bak-rice-idle"):
        shutil.copy2(IDLE, IDLE + ".bak-rice-idle")
    tmp = IDLE + ".tmp"
    open(tmp, "w").write(text)
    os.replace(tmp, IDLE)
    restart_idle()


def screen(state):
    # Hyprland or niri: rice-wm knows which one runs
    try:
        subprocess.run([BIN + "/rice-wm", "dpms", state], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=6)
    except Exception:
        pass


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "state":
        print(json.dumps(load()))
        return
    if cmd == "screen":
        screen(argv[2] if len(argv) > 2 and argv[2] in ("on", "off") else "on")
        return
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.idle.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    if cmd == "apply":
        c = load()
        save(c)
        apply(c)
    elif cmd == "set":
        if len(argv) < 4 or argv[2] not in DEFAULTS:
            die("usage: rice-idle set KEY VALUE   keys: " + " ".join(DEFAULTS))
        c = load()
        lo, hi = RANGES[argv[2]]
        c[argv[2]] = int(max(lo, min(hi, float(argv[3]))))
        save(c)
        apply(c)
    elif cmd == "reset":
        c = dict(DEFAULTS)
        save(c)
        apply(c)
    elif cmd == "restore":
        if os.path.exists(IDLE + ".bak-rice-idle"):
            shutil.copy2(IDLE + ".bak-rice-idle", IDLE)
            print("restored", IDLE)
        restart_idle()
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
