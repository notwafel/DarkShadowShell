#!/usr/bin/env bash
# rice-power [X [Y]]  open the power menu under the bar (X: where the icon is, pixels from the left; Y: from the top, for a bar on the side)
# rice-power lock    lock the screen with your own locker through loginctl (the shell has no lock screen of its own)
if [ "${1:-}" = lock ]; then
  loginctl lock-session 2>/dev/null
  exit 0
fi
if pgrep -f "quickshell/rice-desktop" >/dev/null 2>&1; then
  mkdir -p "$HOME/.cache/rice"
  printf '%s %s\n' "$(date +%s.%N)" "${1:-0} ${2:-}" >"$HOME/.cache/rice/power-open"
else
  exec "$0" lock
fi
